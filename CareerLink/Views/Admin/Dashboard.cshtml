@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-fill me-2 text-primary"></i>Admin Dashboard</h2>
        <p class="text-muted mb-0">CareerLink Platform Management</p>
    </div>
    <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-shield me-1"></i>ADMIN</span>
</div>

<!-- Tab Navigation -->
<ul class="nav nav-tabs mb-4" id="adminTabs">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "overview" ? "active" : "")" href="#overview" data-bs-toggle="tab">
            <i class="bi bi-speedometer2 me-1"></i>Overview
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "users" ? "active" : "")" href="#users" data-bs-toggle="tab">
            <i class="bi bi-people me-1"></i>Users
            <span class="badge bg-secondary ms-1">@Model.TotalUsers</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "jobs" ? "active" : "")" href="#jobs" data-bs-toggle="tab">
            <i class="bi bi-briefcase me-1"></i>Jobs
            <span class="badge bg-secondary ms-1">@Model.TotalJobs</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "reports" ? "active" : "")" href="#reports" data-bs-toggle="tab">
            <i class="bi bi-bar-chart me-1"></i>Reports
        </a>
    </li>
</ul>

<div class="tab-content">
    <!-- OVERVIEW TAB -->
    <div class="tab-pane fade @(Model.ActiveTab == "overview" ? "show active" : "")" id="overview">

        <!-- Main Stats -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-primary text-white h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-white bg-opacity-25 rounded-3 p-2">
                                <i class="bi bi-people fs-4"></i>
                            </div>
                            <div>
                                <div class="fs-2 fw-bold">@Model.TotalUsers</div>
                                <div class="opacity-75 small">Total Users</div>
                            </div>
                        </div>
                        <div class="mt-3 small opacity-75">
                            <span class="badge bg-white text-primary me-1">@Model.JobSeekerCount seekers</span>
                            <span class="badge bg-white text-success">@Model.EmployerCount employers</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-success text-white h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-white bg-opacity-25 rounded-3 p-2">
                                <i class="bi bi-building fs-4"></i>
                            </div>
                            <div>
                                <div class="fs-2 fw-bold">@Model.ActiveCompanies</div>
                                <div class="opacity-75 small">Active Companies</div>
                            </div>
                        </div>
                        <div class="mt-3 small opacity-75">
                            @Model.ActiveJobs active job listings
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-dark bg-opacity-10 rounded-3 p-2">
                                <i class="bi bi-file-earmark-text fs-4"></i>
                            </div>
                            <div>
                                <div class="fs-2 fw-bold">@Model.TotalApplications</div>
                                <div class="opacity-75 small">Total Applications</div>
                            </div>
                        </div>
                        <div class="mt-3 small opacity-75">
                            @Model.ApplicationsThisMonth this month
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-white bg-opacity-25 rounded-3 p-2">
                                <i class="bi bi-cash-stack fs-4"></i>
                            </div>
                            <div>
                                <div class="fs-5 fw-bold">KES @Model.TotalSalaryValue.ToString("N0")</div>
                                <div class="opacity-75 small">Total Salary Value</div>
                            </div>
                        </div>
                        <div class="mt-3 small opacity-75">
                            Across @Model.TotalJobs job listings
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Application Status Distribution -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold py-3">
                <i class="bi bi-pie-chart me-2 text-primary"></i>Application Status Distribution
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    @{
                        var statusData = new[]
                        {
                            (Label: "Pending", Count: Model.PendingApplications, Color: "warning", Icon: "bi-clock"),
                            (Label: "Reviewed", Count: Model.ReviewedApplications, Color: "primary", Icon: "bi-eye"),
                            (Label: "Shortlisted", Count: Model.ShortlistedApplications, Color: "success", Icon: "bi-star"),
                            (Label: "Rejected", Count: Model.RejectedApplications, Color: "danger", Icon: "bi-x-circle"),
                            (Label: "Hired", Count: Model.HiredApplications, Color: "info", Icon: "bi-trophy"),
                        };
                    }
                    @foreach (var sd in statusData)
                    {
                        var pct = Model.TotalApplications > 0 ? (double)sd.Count / Model.TotalApplications * 100 : 0;
                        <div class="col">
                            <div class="card border-0 bg-@(sd.Color) bg-opacity-10 p-3 text-center">
                                <i class="bi @sd.Icon text-@sd.Color fs-4 mb-1"></i>
                                <div class="fs-3 fw-bold text-@sd.Color">@sd.Count</div>
                                <div class="small text-muted">@sd.Label</div>
                                <div class="progress mt-2" style="height: 4px;">
                                    <div class="progress-bar bg-@sd.Color" style="width: @pct.ToString("F0")%"></div>
                                </div>
                                <div class="small text-muted mt-1">@pct.ToString("F0")%</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- USERS TAB -->
    <div class="tab-pane fade @(Model.ActiveTab == "users" ? "show active" : "")" id="users">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-people me-2 text-primary"></i>All Users</h5>
                <span class="text-muted small">@Model.TotalUsers users total</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Joined</th>
                            <th>Last Login</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            var roleBadge = user.Role switch
                            {
                                "admin" => "danger",
                                "employer" => "success",
                                _ => "primary"
                            };
                            <tr class="@(!user.IsActive ? "table-secondary text-muted" : "")">
                                <td>
                                    <div class="fw-semibold">@user.FullName</div>
                                    @if (!user.IsActive)
                                    {
                                        <span class="badge bg-danger small">Suspended</span>
                                    }
                                </td>
                                <td class="small">@user.Email</td>
                                <td><span class="badge bg-@roleBadge">@user.Role.Replace("_", " ").ToUpperInvariant()</span></td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-pause me-1"></i>Suspended</span>
                                    }
                                </td>
                                <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="small text-muted">@(user.LastLoginAt?.ToString("MMM dd, yyyy") ?? "Never")</td>
                                <td class="text-end">
                                    @if (user.Role != "admin")
                                    {
                                        if (user.IsActive)
                                        {
                                            <form asp-action="SuspendUser" method="post" style="display:inline;" onsubmit="return confirm('Suspend @user.FullName?')">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-slash-circle me-1"></i>Suspend
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ActivateUser" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-check-circle me-1"></i>Activate
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- JOBS TAB -->
    <div class="tab-pane fade @(Model.ActiveTab == "jobs" ? "show active" : "")" id="jobs">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-briefcase me-2 text-primary"></i>All Job Listings</h5>
                <span class="text-muted small">@Model.TotalJobs total, @Model.ActiveJobs active</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Job Title</th>
                            <th>Company</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="text-center">Applications</th>
                            <th>Posted</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.Jobs)
                        {
                            var statusBadge = job.Status switch
                            {
                                "active" => "success",
                                "closed" => "secondary",
                                "draft" => "warning",
                                _ => "secondary"
                            };
                            <tr>
                                <td>
                                    <a asp-controller="Job" asp-action="Details" asp-route-id="@job.Id" class="fw-semibold text-decoration-none">
                                        @job.Title
                                    </a>
                                    <div class="small text-muted">@job.Location</div>
                                </td>
                                <td class="small">@job.Employer.CompanyName</td>
                                <td><span class="badge bg-light text-dark border small">@job.JobType.ToUpperInvariant()</span></td>
                                <td><span class="badge bg-@statusBadge">@job.Status.ToUpperInvariant()</span></td>
                                <td class="text-center">
                                    <span class="badge bg-primary rounded-pill">@job.Applications.Count</span>
                                </td>
                                <td class="small text-muted">@job.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        @if (job.Status == "active")
                                        {
                                            <form asp-action="CloseJob" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@job.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Close Job">
                                                    <i class="bi bi-lock"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="RemoveJob" method="post" style="display:inline;" onsubmit="return confirm('Remove this job permanently?')">
                                            <input type="hidden" name="id" value="@job.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Job">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- REPORTS TAB -->
    <div class="tab-pane fade @(Model.ActiveTab == "reports" ? "show active" : "")" id="reports">
        <div class="row g-4">
            <!-- Top Positions -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-semibold py-3">
                        <i class="bi bi-trophy me-2 text-warning"></i>Top Job Positions by Applications
                    </div>
                    <div class="card-body p-4">
                        @if (!Model.TopPositions.Any())
                        {
                            <p class="text-muted text-center">No data available.</p>
                        }
                        else
                        {
                            @foreach (var (pos, idx) in Model.TopPositions.Select((p, i) => (p, i)))
                            {
                                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 @(idx < Model.TopPositions.Count - 1 ? "border-bottom" : "")">
                                    <div>
                                        <div class="fw-semibold">@pos.Title</div>
                                        @if (pos.SalaryMin.HasValue || pos.SalaryMax.HasValue)
                                        {
                                            <div class="small text-muted">
                                                KES @pos.SalaryMin?.ToString("N0") – @pos.SalaryMax?.ToString("N0")
                                            </div>
                                        }
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-primary rounded-pill fs-6">@pos.ApplicationCount</span>
                                        <div class="small text-muted">applications</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Job Type Distribution -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-semibold py-3">
                        <i class="bi bi-bar-chart me-2 text-primary"></i>Job Types Distribution
                    </div>
                    <div class="card-body p-4">
                        @if (!Model.JobTypeCounts.Any())
                        {
                            <p class="text-muted text-center">No data available.</p>
                        }
                        else
                        {
                            var maxCount = Model.JobTypeCounts.Max(j => j.Count);
                            @foreach (var jt in Model.JobTypeCounts)
                            {
                                var pct = maxCount > 0 ? (double)jt.Count / maxCount * 100 : 0;
                                var color = jt.JobType switch
                                {
                                    "full-time" => "primary",
                                    "part-time" => "info",
                                    "contract" => "warning",
                                    "internship" => "success",
                                    "remote" => "purple",
                                    _ => "secondary"
                                };
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-semibold text-capitalize">@jt.JobType</span>
                                        <span class="badge bg-@(color == "purple" ? "secondary" : color)">@jt.Count job@(jt.Count != 1 ? "s" : "")</span>
                                    </div>
                                    <div class="progress" style="height: 12px;">
                                        <div class="progress-bar bg-@(color == "purple" ? "secondary" : color)" style="width: @pct.ToString("F0")%; border-radius: 6px;"></div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Platform Summary -->
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white fw-semibold py-3">
                        <i class="bi bi-info-circle me-2 text-primary"></i>Platform Summary
                    </div>
                    <div class="card-body">
                        <div class="row g-4 text-center">
                            <div class="col-md-2 col-6">
                                <div class="fs-3 fw-bold text-primary">@Model.TotalUsers</div>
                                <div class="small text-muted">Total Users</div>
                            </div>
                            <div class="col-md-2 col-6">
                                <div class="fs-3 fw-bold text-success">@Model.JobSeekerCount</div>
                                <div class="small text-muted">Job Seekers</div>
                            </div>
                            <div class="col-md-2 col-6">
                                <div class="fs-3 fw-bold text-info">@Model.EmployerCount</div>
                                <div class="small text-muted">Employers</div>
                            </div>
                            <div class="col-md-2 col-6">
                                <div class="fs-3 fw-bold text-warning">@Model.TotalJobs</div>
                                <div class="small text-muted">Job Listings</div>
                            </div>
                            <div class="col-md-2 col-6">
                                <div class="fs-3 fw-bold text-danger">@Model.TotalApplications</div>
                                <div class="small text-muted">Applications</div>
                            </div>
                            <div class="col-md-2 col-6">
                                <div class="fs-3 fw-bold" style="color:#6f42c1;">@Model.HiredApplications</div>
                                <div class="small text-muted">Hired</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Activate the correct tab on page load
    const activeTab = '@Model.ActiveTab';
    const tabEl = document.querySelector(`a[href="#${activeTab}"]`);
    if (tabEl) {
        new bootstrap.Tab(tabEl).show();
    }
</script>
}
