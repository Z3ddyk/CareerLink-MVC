@model List<Application>
@{
    ViewData["Title"] = "My Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-file-text me-2 text-primary"></i>My Applications</h2>
        <p class="text-muted mb-0">Track your job applications and their status</p>
    </div>
    <a asp-controller="Job" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-search me-2"></i>Browse More Jobs
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-file-earmark-x display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No Applications Yet</h4>
        <p class="text-muted">You haven't applied to any jobs. Start exploring opportunities!</p>
        <a asp-controller="Job" asp-action="Index" class="btn btn-primary btn-lg mt-2">
            <i class="bi bi-search me-2"></i>Browse Jobs
        </a>
    </div>
}
else
{
    <!-- Status Summary -->
    <div class="row g-3 mb-4">
        @{
            var pending = Model.Count(a => a.Status == "pending");
            var reviewed = Model.Count(a => a.Status == "reviewed");
            var shortlisted = Model.Count(a => a.Status == "shortlisted");
            var hired = Model.Count(a => a.Status == "hired");
        }
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-warning bg-opacity-10 text-center p-3">
                <div class="fs-3 fw-bold text-warning">@pending</div>
                <div class="small text-muted">Pending</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-primary bg-opacity-10 text-center p-3">
                <div class="fs-3 fw-bold text-primary">@reviewed</div>
                <div class="small text-muted">Reviewed</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-success bg-opacity-10 text-center p-3">
                <div class="fs-3 fw-bold text-success">@shortlisted</div>
                <div class="small text-muted">Shortlisted</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-purple bg-opacity-10 text-center p-3" style="background-color: #f3e8ff !important;">
                <div class="fs-3 fw-bold" style="color: #6f42c1;">@hired</div>
                <div class="small text-muted">Hired</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Job Title</th>
                            <th>Company</th>
                            <th>Applied</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Job" asp-action="Details" asp-route-id="@app.JobId" class="text-decoration-none fw-semibold">
                                        @app.Job.Title
                                    </a>
                                    <div class="small text-muted">@app.Job.JobType.Replace("-", " ").ToUpperInvariant()</div>
                                </td>
                                <td>
                                    <i class="bi bi-building me-1 text-muted"></i>
                                    @app.Job.Employer.CompanyName
                                </td>
                                <td class="text-muted small">@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @{
                                        var badgeClass = app.Status switch
                                        {
                                            "pending" => "status-pending",
                                            "reviewed" => "status-reviewed",
                                            "shortlisted" => "status-shortlisted",
                                            "rejected" => "status-rejected",
                                            "hired" => "status-hired",
                                            _ => "bg-secondary text-white"
                                        };
                                        var icon = app.Status switch
                                        {
                                            "pending" => "bi-clock",
                                            "reviewed" => "bi-eye",
                                            "shortlisted" => "bi-star",
                                            "rejected" => "bi-x-circle",
                                            "hired" => "bi-trophy",
                                            _ => "bi-question"
                                        };
                                    }
                                    <span class="badge rounded-pill @badgeClass px-3 py-2">
                                        <i class="bi @icon me-1"></i>@app.Status.ToUpperInvariant()
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="ApplicationDetail" asp-route-id="@app.Id" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
