@model Application
@{
    ViewData["Title"] = "Application Detail";
    var stages = new[] { "pending", "reviewed", "shortlisted", "hired" };
    var currentIdx = Array.IndexOf(stages, Model.Status);
    var isRejected = Model.Status == "rejected";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-action="MyApplications" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
    <div>
        <h3 class="mb-0 fw-bold">Application for @Model.Job.Title</h3>
        <span class="text-muted">@Model.Job.Employer.CompanyName &bull; @Model.AppliedAt.ToString("MMMM dd, yyyy")</span>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Status Timeline -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold py-3">
                <i class="bi bi-signpost-split me-2 text-primary"></i>Application Progress
            </div>
            <div class="card-body p-4">
                @if (isRejected)
                {
                    <div class="alert alert-danger mb-3">
                        <i class="bi bi-x-circle me-2"></i>
                        <strong>Application Not Successful</strong> — The employer has decided not to proceed with your application at this time.
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center position-relative">
                    <!-- Progress line -->
                    <div class="position-absolute" style="top: 20px; left: 12%; right: 12%; height: 3px; background: #dee2e6; z-index: 0;">
                        @if (!isRejected && currentIdx > 0)
                        {
                            <div class="bg-success h-100 rounded" style="width: @(currentIdx * 33.3)%;"></div>
                        }
                    </div>

                    @for (int i = 0; i < stages.Length; i++)
                    {
                        var stage = stages[i];
                        var isPassed = !isRejected && i <= currentIdx;
                        var isCurrent = !isRejected && i == currentIdx;
                        var icon = stage switch
                        {
                            "pending" => "bi-clock",
                            "reviewed" => "bi-eye",
                            "shortlisted" => "bi-star",
                            "hired" => "bi-trophy",
                            _ => "bi-circle"
                        };
                        <div class="text-center position-relative" style="z-index: 1; flex: 1;">
                            <div class="timeline-icon mx-auto mb-2 @(isPassed ? "bg-success text-white" : "bg-white border-2 border text-muted") @(isCurrent ? "shadow" : "")"
                                 style="width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;@(isCurrent ? "outline: 3px solid #198754; outline-offset: 2px;" : "")">
                                <i class="bi @icon"></i>
                            </div>
                            <div class="small fw-semibold @(isPassed ? "text-success" : "text-muted")">
                                @stage.ToUpperInvariant()
                            </div>
                        </div>
                    }
                </div>

                @if (!isRejected && currentIdx >= 0)
                {
                    <div class="mt-4 p-3 bg-success bg-opacity-10 rounded text-center">
                        <strong class="text-success">
                            @(Model.Status switch
                            {
                                "pending" => "Your application is awaiting review by the employer.",
                                "reviewed" => "The employer has reviewed your application!",
                                "shortlisted" => "Congratulations! You have been shortlisted for an interview.",
                                "hired" => "Congratulations! You got the job!",
                                _ => ""
                            })
                        </strong>
                    </div>
                }
            </div>
        </div>

        <!-- Cover Letter -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold py-3">
                <i class="bi bi-file-text me-2 text-primary"></i>Your Cover Letter
            </div>
            <div class="card-body p-4">
                <div class="p-3 bg-light rounded" style="white-space: pre-line;">@Model.CoverLetter</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.EmployerNotes))
        {
            <div class="card border-0 shadow-sm border-start border-4 border-info mb-4">
                <div class="card-header bg-white fw-semibold py-3">
                    <i class="bi bi-chat-quote me-2 text-info"></i>Employer Feedback
                </div>
                <div class="card-body p-4">
                    <p class="mb-0">@Model.EmployerNotes</p>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Job Info Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold py-3">
                <i class="bi bi-briefcase me-2 text-primary"></i>Job Details
            </div>
            <div class="card-body p-4">
                <h5 class="fw-bold">@Model.Job.Title</h5>
                <p class="text-muted">@Model.Job.Employer.CompanyName</p>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-geo-alt me-2 text-primary"></i>@Model.Job.Location</li>
                    <li class="mb-2"><i class="bi bi-tag me-2 text-primary"></i>@Model.Job.JobType.Replace("-", " ").ToUpperInvariant()</li>
                    @if (Model.Job.SalaryMin.HasValue || Model.Job.SalaryMax.HasValue)
                    {
                        <li class="mb-2">
                            <i class="bi bi-cash me-2 text-primary"></i>
                            KES @Model.Job.SalaryMin?.ToString("N0") — @Model.Job.SalaryMax?.ToString("N0")
                        </li>
                    }
                    <li class="mb-2"><i class="bi bi-calendar me-2 text-primary"></i>Applied: @Model.AppliedAt.ToString("MMM dd, yyyy")</li>
                </ul>
                <a asp-controller="Job" asp-action="Details" asp-route-id="@Model.JobId" class="btn btn-outline-primary btn-sm w-100">
                    <i class="bi bi-eye me-1"></i>View Job Posting
                </a>
            </div>
        </div>

        <a asp-action="MyApplications" class="btn btn-outline-secondary w-100">
            <i class="bi bi-arrow-left me-2"></i>All Applications
        </a>
    </div>
</div>
