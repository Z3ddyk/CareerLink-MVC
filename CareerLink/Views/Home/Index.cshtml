@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="bg-primary text-white rounded-3 p-5 mb-4 shadow">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <h1 class="display-5 fw-bold mb-3">Find Your Next Career Opportunity in Kenya</h1>
            <p class="lead mb-4">CareerLink connects talented Kenyans with leading employers. Discover thousands of jobs across Nairobi, Mombasa, Kisumu and beyond.</p>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Job" asp-action="Index" class="btn btn-light btn-lg">
                    <i class="bi bi-search me-2"></i>Browse Jobs
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-person-plus me-2"></i>Get Started Free
                </a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center">
            <i class="bi bi-people-fill" style="font-size: 8rem; opacity: 0.3;"></i>
        </div>
    </div>
</div>

<!-- Live Stats -->
<div class="row g-3 mb-5">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="text-primary fs-1 fw-bold">@ViewBag.ActiveJobs</div>
            <div class="text-muted">Active Job Listings</div>
            <small class="text-success"><i class="bi bi-arrow-up"></i> Updated live</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="text-success fs-1 fw-bold">@ViewBag.CompaniesHiring</div>
            <div class="text-muted">Companies Hiring</div>
            <small class="text-success"><i class="bi bi-building"></i> Top Kenyan employers</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="text-warning fs-1 fw-bold">@ViewBag.ApplicationsThisMonth</div>
            <div class="text-muted">Applications This Month</div>
            <small class="text-success"><i class="bi bi-graph-up"></i> Growing community</small>
        </div>
    </div>
</div>

<!-- Features -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm job-card">
            <div class="card-body text-center p-4">
                <div class="bg-primary bg-opacity-10 rounded-3 p-3 d-inline-block mb-3">
                    <i class="bi bi-search display-5 text-primary"></i>
                </div>
                <h5 class="card-title fw-bold">Find Jobs</h5>
                <p class="card-text text-muted">Search and filter through job listings across Kenya. Filter by type, location, salary, and skills.</p>
                <a asp-controller="Job" asp-action="Index" class="btn btn-outline-primary btn-sm">Browse Now</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm job-card">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 rounded-3 p-3 d-inline-block mb-3">
                    <i class="bi bi-building display-5 text-success"></i>
                </div>
                <h5 class="card-title fw-bold">Post Jobs</h5>
                <p class="card-text text-muted">Employers can post job listings and manage applications from a single, easy-to-use dashboard.</p>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-success btn-sm">Post a Job</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm job-card">
            <div class="card-body text-center p-4">
                <div class="bg-warning bg-opacity-10 rounded-3 p-3 d-inline-block mb-3">
                    <i class="bi bi-graph-up display-5 text-warning"></i>
                </div>
                <h5 class="card-title fw-bold">Track Applications</h5>
                <p class="card-text text-muted">Monitor your application status in real-time. Get updates as employers review, shortlist, or hire.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-warning btn-sm">Track Now</a>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action -->
<div class="bg-light rounded-3 p-4 text-center border">
    <h4 class="fw-bold mb-2">Ready to advance your career?</h4>
    <p class="text-muted mb-3">Join thousands of Kenyans who have found their dream jobs through CareerLink.</p>
    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2">
        <i class="bi bi-person-plus me-2"></i>Register as Job Seeker
    </a>
    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">
        <i class="bi bi-building me-2"></i>Register as Employer
    </a>
</div>
