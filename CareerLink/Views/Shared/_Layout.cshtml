<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CareerLink</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar-brand { font-size: 1.4rem; letter-spacing: -0.5px; }
        .job-card { transition: transform 0.2s, box-shadow 0.2s; }
        .job-card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
        .status-pending { background-color: #fff3cd; color: #856404; }
        .status-reviewed { background-color: #cfe2ff; color: #084298; }
        .status-shortlisted { background-color: #d1e7dd; color: #0a3622; }
        .status-rejected { background-color: #f8d7da; color: #842029; }
        .status-hired { background-color: #e2d9f3; color: #432874; }
        .timeline-step { position: relative; }
        .timeline-step::before { content: ''; position: absolute; left: 50%; top: 20px; height: 100%; width: 2px; background: #dee2e6; transform: translateX(-50%); z-index: 0; }
        .timeline-step:last-child::before { display: none; }
        .timeline-icon { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; z-index: 1; position: relative; margin: 0 auto; }
        footer a { color: #6c757d; text-decoration: none; }
        footer a:hover { color: #0d6efd; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-briefcase-fill me-2"></i>CareerLink
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Job" asp-action="Index">
                            <i class="bi bi-search me-1"></i>Browse Jobs
                        </a>
                    </li>
                    @if (Context.Session.GetString("UserRole") == "admin")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-shield-fill me-1"></i>Admin
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard" asp-route-tab="overview"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard" asp-route-tab="users"><i class="bi bi-people me-2"></i>Users</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard" asp-route-tab="jobs"><i class="bi bi-briefcase me-2"></i>Jobs</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard" asp-route-tab="reports"><i class="bi bi-bar-chart me-2"></i>Reports</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (Context.Session.GetString("UserId") != null)
                    {
                        @if (Context.Session.GetString("UserRole") == "job_seeker")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="MyApplications">
                                    <i class="bi bi-file-text me-1"></i>My Applications
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Job" asp-action="SavedJobs">
                                    <i class="bi bi-bookmark me-1"></i>Saved Jobs
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person me-1"></i>Profile
                                </a>
                            </li>
                        }
                        else if (Context.Session.GetString("UserRole") == "employer")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employer" asp-action="Dashboard">
                                    <i class="bi bi-building me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employer" asp-action="PostJob">
                                    <i class="bi bi-plus-circle me-1"></i>Post Job
                                </a>
                            </li>
                        }
                        else if (Context.Session.GetString("UserRole") == "admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UserName")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text text-muted small">@Context.Session.GetString("UserRole")?.Replace("_", " ")?.ToUpper()</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-light btn-sm ms-2 my-1" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4 mb-5">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h6 class="fw-bold text-primary"><i class="bi bi-briefcase-fill me-2"></i>CareerLink</h6>
                    <p class="text-muted small">Connecting Kenyan talent with opportunities. Reducing unemployment one job at a time.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Job" asp-action="Index">Browse Jobs</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Create Account</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Contact</h6>
                    <p class="text-muted small"><i class="bi bi-envelope me-1"></i>support@careerlink.co.ke</p>
                    <p class="text-muted small">&copy; @DateTime.Now.Year CareerLink. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
