@model JobIndexViewModel
@{
    ViewData["Title"] = "Browse Jobs";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold mb-1"><i class="bi bi-search me-2 text-primary"></i>Browse Jobs</h2>
        <p class="text-muted">Find your perfect opportunity in Kenya</p>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold mb-1">Keyword</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Job title, skill, or company..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Job Type</label>
                    <select name="jobType" class="form-select">
                        <option value="">All Types</option>
                        <option value="full-time" selected="@(Model.JobType == "full-time")">Full-Time</option>
                        <option value="part-time" selected="@(Model.JobType == "part-time")">Part-Time</option>
                        <option value="contract" selected="@(Model.JobType == "contract")">Contract</option>
                        <option value="internship" selected="@(Model.JobType == "internship")">Internship</option>
                        <option value="remote" selected="@(Model.JobType == "remote")">Remote</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Location</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                        <input type="text" name="location" value="@Model.Location" class="form-control" placeholder="Nairobi, Mombasa..." />
                    </div>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Results Count + Clear -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <strong>@Model.TotalCount</strong> <span class="text-muted">job@(Model.TotalCount != 1 ? "s" : "") found</span>
        @if (!string.IsNullOrWhiteSpace(Model.Keyword) || !string.IsNullOrWhiteSpace(Model.JobType) || !string.IsNullOrWhiteSpace(Model.Location))
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-2">
                <i class="bi bi-x-circle me-1"></i>Clear Filters
            </a>
        }
    </div>
    <span class="text-muted small">Page @Model.Page of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
</div>

@if (!Model.Jobs.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-search display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No Jobs Found</h4>
        <p class="text-muted">Try adjusting your search filters.</p>
        <a asp-action="Index" class="btn btn-primary mt-2">
            <i class="bi bi-list me-2"></i>View All Jobs
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var job in Model.Jobs)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 border-0 shadow-sm job-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                <i class="bi bi-building text-primary fs-5"></i>
                            </div>
                            @{
                                var typeBadge = job.JobType switch
                                {
                                    "full-time" => "bg-primary",
                                    "part-time" => "bg-info",
                                    "contract" => "bg-warning",
                                    "internship" => "bg-success",
                                    "remote" => "bg-purple text-white",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @(job.JobType == "remote" ? "bg-success" : typeBadge) rounded-pill small">
                                @job.JobType.ToUpperInvariant()
                            </span>
                        </div>

                        <h5 class="card-title fw-bold mb-1">
                            <a asp-action="Details" asp-route-id="@job.Id" class="text-decoration-none text-dark stretched-link">
                                @job.Title
                            </a>
                        </h5>
                        <div class="text-muted small mb-2">
                            <i class="bi bi-building me-1"></i>@job.Employer.CompanyName
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-3 small text-muted">
                            <span><i class="bi bi-geo-alt me-1"></i>@job.Location</span>
                            @if (job.SalaryMin.HasValue || job.SalaryMax.HasValue)
                            {
                                <span><i class="bi bi-cash me-1"></i>KES @job.SalaryMin?.ToString("N0") – @job.SalaryMax?.ToString("N0")</span>
                            }
                        </div>

                        @if (job.JobSkills.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var skill in job.JobSkills.Take(3))
                                {
                                    <span class="badge bg-light text-dark border small">@skill.Skill.Name</span>
                                }
                                @if (job.JobSkills.Count > 3)
                                {
                                    <span class="badge bg-light text-muted border small">+@(job.JobSkills.Count - 3) more</span>
                                }
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>@job.CreatedAt.ToString("MMM dd, yyyy")
                            </small>
                            <small class="text-muted">
                                <i class="bi bi-eye me-1"></i>@job.ViewsCount views
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-jobType="@Model.JobType" asp-route-location="@Model.Location" asp-route-page="@(Model.Page - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-jobType="@Model.JobType" asp-route-location="@Model.Location" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-jobType="@Model.JobType" asp-route-location="@Model.Location" asp-route-page="@(Model.Page + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
