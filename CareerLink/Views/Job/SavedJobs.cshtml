@model List<SavedJob>
@{
    ViewData["Title"] = "Saved Jobs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-bookmark-fill me-2 text-warning"></i>Saved Jobs</h2>
        <p class="text-muted mb-0">Jobs you've bookmarked for later</p>
    </div>
    <a asp-action="Index" class="btn btn-primary">
        <i class="bi bi-search me-2"></i>Browse More Jobs
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-bookmark display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No Saved Jobs Yet</h4>
        <p class="text-muted">Browse jobs and click the bookmark button to save them for later.</p>
        <a asp-action="Index" class="btn btn-primary btn-lg mt-2">
            <i class="bi bi-search me-2"></i>Browse Jobs
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var saved in Model)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm job-card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary border">
                                @saved.Job.JobType.ToUpperInvariant()
                            </span>
                            <small class="text-muted"><i class="bi bi-bookmark-fill text-warning me-1"></i>Saved @saved.SavedAt.ToString("MMM dd")</small>
                        </div>
                        <h5 class="fw-bold mb-1">
                            <a asp-controller="Job" asp-action="Details" asp-route-id="@saved.Job.Id" class="text-decoration-none text-dark stretched-link">
                                @saved.Job.Title
                            </a>
                        </h5>
                        <div class="text-muted small mb-2">
                            <i class="bi bi-building me-1"></i>@saved.Job.Employer.CompanyName
                        </div>
                        <div class="d-flex flex-wrap gap-2 small text-muted mb-3">
                            <span><i class="bi bi-geo-alt me-1"></i>@saved.Job.Location</span>
                            @if (saved.Job.SalaryMin.HasValue)
                            {
                                <span><i class="bi bi-cash me-1"></i>KES @saved.Job.SalaryMin?.ToString("N0") – @saved.Job.SalaryMax?.ToString("N0")</span>
                            }
                        </div>
                        @if (saved.Job.JobSkills.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var skill in saved.Job.JobSkills.Take(3))
                                {
                                    <span class="badge bg-light text-dark border small">@skill.Skill.Name</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white border-0 d-flex gap-2 px-4 pb-3">
                        <a asp-controller="Job" asp-action="Details" asp-route-id="@saved.Job.Id" class="btn btn-outline-primary btn-sm flex-fill">
                            <i class="bi bi-eye me-1"></i>View
                        </a>
                        <form asp-action="SaveJob" asp-controller="Job" method="post" class="flex-fill">
                            <input type="hidden" name="jobId" value="@saved.Job.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                <i class="bi bi-bookmark-x me-1"></i>Remove
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
