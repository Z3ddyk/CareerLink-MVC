@model ApplyViewModel
@{
    ViewData["Title"] = "Apply - " + Model.JobTitle;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-3">
            <a asp-action="Details" asp-route-id="@Model.JobId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Job
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="bi bi-send me-2"></i>Apply for @Model.JobTitle</h5>
                <div class="small opacity-75">@Model.CompanyName</div>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info py-2 small mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    Write a compelling cover letter explaining why you're a great fit for this role. Be specific about your relevant experience and skills.
                </div>

                <form asp-action="Apply" method="post">
                    <input type="hidden" asp-for="JobId" />
                    <input type="hidden" asp-for="JobTitle" />
                    <input type="hidden" asp-for="CompanyName" />

                    <div class="mb-4">
                        <label asp-for="CoverLetter" class="form-label fw-semibold">
                            <i class="bi bi-file-text me-1"></i>Cover Letter <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="CoverLetter" class="form-control" rows="12"
                            placeholder="Dear Hiring Manager,&#10;&#10;I am excited to apply for the position of @Model.JobTitle at @Model.CompanyName...&#10;&#10;In my current/previous role, I have...&#10;&#10;I would welcome the opportunity to discuss how my skills align with your team's needs.&#10;&#10;Sincerely,&#10;[Your Name]"></textarea>
                        <div class="d-flex justify-content-between mt-1">
                            <span asp-validation-for="CoverLetter" class="text-danger small"></span>
                            <span class="text-muted small" id="charCount">0 characters</span>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary btn-lg flex-fill">
                            <i class="bi bi-send me-2"></i>Submit Application
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.JobId" class="btn btn-outline-secondary btn-lg">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const textarea = document.querySelector('textarea[name="CoverLetter"]');
    const counter = document.getElementById('charCount');
    function updateCount() {
        const len = textarea.value.length;
        counter.textContent = len + ' characters';
        counter.className = 'small ' + (len < 50 ? 'text-danger' : 'text-muted');
    }
    textarea.addEventListener('input', updateCount);
    updateCount();
</script>
}
