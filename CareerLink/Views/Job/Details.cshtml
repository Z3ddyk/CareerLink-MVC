@model JobDetailViewModel
@{
    ViewData["Title"] = Model.Job.Title;
    var job = Model.Job;
    var userRole = Context.Session.GetString("UserRole");
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Jobs
    </a>
</div>

<div class="row g-4">
    <!-- Main Content -->
    <div class="col-lg-8">
        <!-- Job Header -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div class="d-flex gap-3">
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3 d-flex align-items-center justify-content-center" style="min-width:60px;height:60px;">
                            <i class="bi bi-building text-primary fs-3"></i>
                        </div>
                        <div>
                            <h2 class="fw-bold mb-1">@job.Title</h2>
                            <div class="text-muted">@job.Employer.CompanyName</div>
                        </div>
                    </div>
                    @if (Model.SkillMatchPercent > 0)
                    {
                        <div class="text-end">
                            @{
                                var matchColor = Model.SkillMatchPercent >= 70 ? "success" : Model.SkillMatchPercent >= 40 ? "warning" : "secondary";
                            }
                            <div class="badge bg-@matchColor fs-6 px-3 py-2">
                                <i class="bi bi-lightning me-1"></i>@Model.SkillMatchPercent% Match
                            </div>
                            <div class="small text-muted mt-1">Based on your skills</div>
                        </div>
                    }
                </div>

                <!-- Key Details -->
                <div class="row g-3 mt-3 pt-3 border-top">
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Location</div>
                        <div class="fw-semibold"><i class="bi bi-geo-alt text-primary me-1"></i>@job.Location</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Job Type</div>
                        <div class="fw-semibold"><i class="bi bi-briefcase text-primary me-1"></i>@job.JobType.Replace("-", " ").ToUpperInvariant()</div>
                    </div>
                    @if (job.SalaryMin.HasValue || job.SalaryMax.HasValue)
                    {
                        <div class="col-6 col-md-3">
                            <div class="small text-muted">Salary (KES/mo)</div>
                            <div class="fw-semibold text-success"><i class="bi bi-cash me-1"></i>@job.SalaryMin?.ToString("N0") – @job.SalaryMax?.ToString("N0")</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(job.ExperienceYears))
                    {
                        <div class="col-6 col-md-3">
                            <div class="small text-muted">Experience</div>
                            <div class="fw-semibold"><i class="bi bi-award text-primary me-1"></i>@job.ExperienceYears</div>
                        </div>
                    }
                </div>

                @if (job.Deadline.HasValue)
                {
                    <div class="mt-3 small">
                        <span class="text-muted"><i class="bi bi-calendar-x me-1"></i>Apply by: </span>
                        <strong class="@(job.Deadline < DateTime.Now.AddDays(7) ? "text-danger" : "text-dark")">
                            @job.Deadline.Value.ToString("MMMM dd, yyyy")
                        </strong>
                    </div>
                }
            </div>
        </div>

        <!-- Description -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold py-3">
                <i class="bi bi-file-text me-2 text-primary"></i>Job Description
            </div>
            <div class="card-body p-4" style="white-space: pre-line;">@job.Description</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(job.Requirements))
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold py-3">
                    <i class="bi bi-list-check me-2 text-primary"></i>Requirements
                </div>
                <div class="card-body p-4" style="white-space: pre-line;">@job.Requirements</div>
            </div>
        }

        <!-- Skills -->
        @if (job.JobSkills.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold py-3">
                    <i class="bi bi-tools me-2 text-primary"></i>Required Skills
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var js in job.JobSkills)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-3 py-2">
                                @js.Skill.Name
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Apply / Status Card -->
        <div class="card border-0 shadow mb-4">
            <div class="card-body p-4">
                @if (userRole == "job_seeker")
                {
                    @if (Model.HasApplied)
                    {
                        var badgeClass = Model.ExistingApplication?.Status switch
                        {
                            "pending" => "status-pending",
                            "reviewed" => "status-reviewed",
                            "shortlisted" => "status-shortlisted",
                            "rejected" => "status-rejected",
                            "hired" => "status-hired",
                            _ => "bg-secondary text-white"
                        };
                        <div class="text-center mb-3">
                            <i class="bi bi-check-circle-fill text-success fs-1"></i>
                            <h6 class="mt-2">Application Submitted</h6>
                            <span class="badge @badgeClass px-3 py-2">@Model.ExistingApplication?.Status?.ToUpperInvariant()</span>
                        </div>
                        <a asp-controller="Account" asp-action="ApplicationDetail" asp-route-id="@Model.ExistingApplication?.Id" class="btn btn-outline-primary w-100">
                            <i class="bi bi-eye me-2"></i>View Application
                        </a>
                    }
                    else if (job.Status == "active")
                    {
                        <div class="d-grid gap-2">
                            <a asp-action="Apply" asp-route-id="@job.Id" class="btn btn-primary btn-lg">
                                <i class="bi bi-send me-2"></i>Apply Now
                            </a>
                            <form asp-action="SaveJob" method="post">
                                <input type="hidden" name="jobId" value="@job.Id" />
                                <button type="submit" class="btn @(Model.IsSaved ? "btn-warning" : "btn-outline-secondary") w-100">
                                    <i class="bi @(Model.IsSaved ? "bi-bookmark-fill" : "bi-bookmark") me-2"></i>
                                    @(Model.IsSaved ? "Saved" : "Save Job")
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="bi bi-lock fs-3"></i>
                            <p class="mt-2">This job is no longer accepting applications.</p>
                        </div>
                    }
                }
                else if (userRole == null)
                {
                    <div class="text-center">
                        <p class="text-muted mb-3">Login to apply for this job</p>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Login to Apply
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary w-100">
                            <i class="bi bi-person-plus me-2"></i>Create Account
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="bi bi-info-circle fs-3"></i>
                        <p class="mt-2 small">Only job seekers can apply. Switch to a job seeker account to apply.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Company Info -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold py-3">
                <i class="bi bi-building me-2 text-primary"></i>About the Company
            </div>
            <div class="card-body p-4">
                <h6 class="fw-bold">@job.Employer.CompanyName</h6>
                @if (!string.IsNullOrWhiteSpace(job.Employer.Industry))
                {
                    <div class="small text-muted mb-2"><i class="bi bi-tag me-1"></i>@job.Employer.Industry</div>
                }
                @if (!string.IsNullOrWhiteSpace(job.Employer.Headquarters))
                {
                    <div class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@job.Employer.Headquarters</div>
                }
                @if (!string.IsNullOrWhiteSpace(job.Employer.CompanySize))
                {
                    <div class="small text-muted mb-2"><i class="bi bi-people me-1"></i>@job.Employer.CompanySize employees</div>
                }
                @if (job.Employer.FoundedYear.HasValue)
                {
                    <div class="small text-muted mb-2"><i class="bi bi-calendar me-1"></i>Founded @job.Employer.FoundedYear</div>
                }
                @if (!string.IsNullOrWhiteSpace(job.Employer.Description))
                {
                    <p class="small text-muted mt-3">@(job.Employer.Description.Length > 200 ? job.Employer.Description.Substring(0, 200) + "..." : job.Employer.Description)</p>
                }
                @if (!string.IsNullOrWhiteSpace(job.Employer.WebsiteUrl))
                {
                    <a href="@job.Employer.WebsiteUrl" target="_blank" class="btn btn-outline-primary btn-sm w-100 mt-2">
                        <i class="bi bi-globe me-1"></i>Visit Website
                    </a>
                }
            </div>
        </div>

        <div class="text-center text-muted small">
            <i class="bi bi-eye me-1"></i>@job.ViewsCount views &bull;
            <i class="bi bi-clock me-1"></i>Posted @job.CreatedAt.ToString("MMM dd, yyyy")
        </div>
    </div>
</div>
