@model PostJobViewModel
@{
    ViewData["Title"] = "Edit Job";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>
    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-pencil me-2 text-primary"></i>Edit Job Listing
        </h2>
    </div>
</div>

<form asp-action="EditJob" method="post">
    <input type="hidden" asp-for="JobId" />

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold py-3">
                    <i class="bi bi-info-circle me-2 text-primary"></i>Job Details
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Senior Software Engineer" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="JobType" class="form-label fw-semibold"></label>
                            <select asp-for="JobType" class="form-select">
                                <option value="full-time">Full-Time</option>
                                <option value="part-time">Part-Time</option>
                                <option value="contract">Contract</option>
                                <option value="internship">Internship</option>
                                <option value="remote">Remote</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="active">Active (Accepting Applications)</option>
                                <option value="draft">Draft (Not Published)</option>
                                <option value="paused">Paused</option>
                                <option value="closed">Closed</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-semibold"></label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Nairobi, Kenya" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExperienceYears" class="form-label fw-semibold"></label>
                            <input asp-for="ExperienceYears" class="form-control" placeholder="e.g. 3-5 years" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Requirements" class="form-label fw-semibold"></label>
                        <textarea asp-for="Requirements" class="form-control" rows="5"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SkillsText" class="form-label fw-semibold"></label>
                        <input asp-for="SkillsText" class="form-control" placeholder="Python, React, SQL..." />
                        <div class="form-text">Separate skills with commas.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold py-3">
                    <i class="bi bi-cash-stack me-2 text-primary"></i>Compensation
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="SalaryMin" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">KES</span>
                            <input asp-for="SalaryMin" type="number" min="0" step="1000" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SalaryMax" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">KES</span>
                            <input asp-for="SalaryMax" type="number" min="0" step="1000" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold py-3">
                    <i class="bi bi-calendar me-2 text-primary"></i>Deadline
                </div>
                <div class="card-body p-4">
                    <input asp-for="Deadline" type="date" class="form-control"
                        value="@Model.Deadline?.ToString("yyyy-MM-dd")" />
                    <div class="form-text">Leave blank for no deadline.</div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save me-2"></i>Save Changes
                </button>
                <a asp-action="Dashboard" class="btn btn-outline-secondary">
                    <i class="bi bi-x me-2"></i>Cancel
                </a>
            </div>
        </div>
    </div>
</form>
