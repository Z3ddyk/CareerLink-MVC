@model EmployerDashboardViewModel
@{
    ViewData["Title"] = "Employer Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-building me-2 text-primary"></i>@Model.EmployerProfile?.CompanyName
        </h2>
        <p class="text-muted mb-0">Employer Dashboard</p>
    </div>
    <a asp-action="PostJob" class="btn btn-primary btn-lg">
        <i class="bi bi-plus-circle me-2"></i>Post New Job
    </a>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="bg-white bg-opacity-25 rounded-3 p-3">
                    <i class="bi bi-briefcase fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@Model.ActiveJobsCount</div>
                    <div class="opacity-75">Active Job Listings</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="bg-white bg-opacity-25 rounded-3 p-3">
                    <i class="bi bi-people fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@Model.TotalApplicationsCount</div>
                    <div class="opacity-75">Total Applications</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="bg-dark bg-opacity-10 rounded-3 p-3">
                    <i class="bi bi-clock-history fs-3"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@Model.ToReviewCount</div>
                    <div class="opacity-75">Pending Review</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Job Listings Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-semibold"><i class="bi bi-list-ul me-2 text-primary"></i>Your Job Listings</h5>
        <span class="badge bg-primary rounded-pill">@Model.JobsWithStats.Count jobs</span>
    </div>

    @if (!Model.JobsWithStats.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-briefcase display-3 text-muted"></i>
            <h5 class="mt-3 text-muted">No Job Listings Yet</h5>
            <p class="text-muted">Post your first job to start receiving applications.</p>
            <a asp-action="PostJob" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Post Your First Job
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Job Title</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-center">Applications</th>
                        <th>Posted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.JobsWithStats)
                    {
                        var job = item.Job;
                        var statusBadge = job.Status switch
                        {
                            "active" => "bg-success",
                            "closed" => "bg-secondary",
                            "draft" => "bg-warning text-dark",
                            "paused" => "bg-info",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>
                                <div class="fw-semibold">@job.Title</div>
                                <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@job.Location</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@job.JobType.ToUpperInvariant()</span></td>
                            <td><span class="badge @statusBadge">@job.Status.ToUpperInvariant()</span></td>
                            <td class="text-center">
                                <a asp-action="ViewApplications" asp-route-id="@job.Id" class="text-decoration-none">
                                    <span class="badge bg-primary rounded-pill fs-6">@item.ApplicationCount</span>
                                </a>
                            </td>
                            <td class="text-muted small">@job.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="EditJob" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ViewApplications" asp-route-id="@job.Id" class="btn btn-sm btn-outline-success" title="Applications">
                                        <i class="bi bi-people"></i>
                                    </a>
                                    <a asp-controller="Job" asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary" title="Preview" target="_blank">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="DeleteJob" method="post" style="display:inline;" onsubmit="return confirm('Delete this job? This will also remove all applications.')">
                                        <input type="hidden" name="id" value="@job.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
